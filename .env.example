# Copy this file to .env (which is gitignored) and adjust as needed.
# Never commit a real .env file or any credentials. The application needs
# no secrets: every variable below is non-sensitive configuration, and all
# are optional.

# --- Dashboard (dashboard/api_client.py) ---------------------------------
# Base URL of the FastAPI service. Defaults to http://localhost:8000.
# Docker Compose sets http://api:8000.
API_BASE_URL=http://localhost:8000
# Set to "inprocess" to serve the FastAPI app inside the Streamlit process
# instead of calling it over HTTP. streamlit_app.py (the Streamlit Community
# Cloud entry point) sets this itself; leave it unset for Docker/local HTTP.
DASHBOARD_API_MODE=

# --- API (src/models/mlflow_tracking.py) ---------------------------------
# Directory holding packaged registered model versions. Defaults to
# models/registered/ in the project root.
MODEL_ARTIFACT_ROOT=
