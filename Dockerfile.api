# Phase 13: FastAPI inference service container.
#
# Serves the frozen Phase 7 Logistic Regression via its Phase 10 MLflow
# Model Registry entry, with Phase 8 SHAP explanations and Phase 9
# next-best-action recommendations layered on top -- exactly as it runs
# locally with `uvicorn api.main:app --reload`. No application code is
# changed for containerization.
#
# Runtime dependencies NOT baked into this image (see .dockerignore and
# docker-compose.yml): data/processed/customer_features.parquet,
# mlruns.db, and mlartifacts/ are git-ignored, developer-generated
# artifacts supplied as read-only bind mounts at `docker compose up`
# time. If they are missing on the host, the container still starts, but
# /health reports "unhealthy" -- exactly the same failure mode as running
# `uvicorn api.main:app --reload` locally without having run Phases 1-10
# first. Nothing here invents a substitute model or dataset.

FROM python:3.14-slim

WORKDIR /app

# Install Python dependencies first so this layer is cached across
# source-code-only changes.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Application source (api/, src/, configs/, reports/*.csv, requirements.txt,
# etc.) -- .dockerignore excludes .venv/, .git/, notebooks/, tests/, and
# every git-ignored data/model artifact described above.
COPY . .

# Run as a non-root user.
RUN groupadd --system app && useradd --system --gid app --home /app app \
    && chown -R app:app /app
USER app

EXPOSE 8000

# Uses the API's own existing GET /health endpoint -- no second health
# system is introduced. urllib (stdlib) avoids adding a curl/wget package
# just for this check. urlopen raises on any non-2xx response (e.g. the
# 503 /health itself returns when the model failed to load); Python exits
# non-zero on any uncaught exception, which is exactly what a Docker
# HEALTHCHECK needs to mark the container unhealthy.
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health', timeout=3)"

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
