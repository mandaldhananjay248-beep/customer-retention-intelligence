# Phase 13/15: Streamlit dashboard container.
#
# Runs the existing dashboard/app.py unchanged. This container never
# loads the ML model, computes SHAP values, or evaluates recommendation
# rules itself -- it only talks HTTP to the API via dashboard/api_client.py
# (Docker Compose sets API_BASE_URL=http://api:8000, the compose service
# name).
#
# data/processed/customer_features.parquet -- used only to populate the
# customer/snapshot selection dropdowns and to build API request payloads,
# never to compute a prediction -- is regenerated at build time from the
# committed, seeded Phase 1-4 pipeline (fingerprint verified), the same way
# Dockerfile.api does it. No dataset is committed or downloaded.

FROM python:3.14-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Install Python dependencies first so this layer is cached across
# source-code-only changes.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Application source (dashboard/, reports/*.csv, requirements.txt, etc.)
# -- .dockerignore excludes .venv/, .git/, notebooks/, tests/, and local
# data/model state. api/ and src/ are also copied in (single shared build
# context for both images); dashboard/ code never imports the ML modules --
# see tests/test_dashboard.py's import guardrail test. src/ is only run
# here, at build time, to regenerate the dataset.
COPY . .

RUN python -m src.data.regenerate_feature_dataset --prune

# Run as a non-root user.
RUN groupadd --system app && useradd --system --gid app --home /app app \
    && chown -R app:app /app
USER app

EXPOSE 8501

# Streamlit's own built-in health endpoint (a pre-existing Streamlit
# feature, not something added for this project) -- no second health
# system is introduced.
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8501/_stcore/health', timeout=3)"

CMD ["streamlit", "run", "dashboard/app.py", "--server.address", "0.0.0.0", "--server.port", "8501", "--server.headless", "true"]
